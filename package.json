{
  "name": "lovelace-entity-progress-card",
  "version": "1.0.0",
  "description": "A modern Entity progress card for Home Assistant's Lovelace UI.",
  "main": "src/index.ts",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "check:syntax": "find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "lint": "eslint \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\"",
    "type-check": "tsc",
    "type-check:test": "tsc -p test/tsconfig.json",
    "i18n:validate": "node scripts/translations.js validate",
    "i18n:validate:structure": "node scripts/translations.js validate --structure-only",
    "i18n:sync": "node scripts/translations.js synchronize --to-js",
    "check:code": "npm run check:syntax && npm run format:js:check && npm run lint && npm run type-check && npm run type-check:test && npm run i18n:validate:structure && npm test",
    "check:github": "npm run check:release-flags && npm run check:code && npm run lint:unused && npm run i18n:validate && npm run lint:md && npm run build:prod && node --check dist/entity-progress-card.js && npm run check:es-target && npm run test:dom",
    "check:push": "npm run check:github && npm run build:test && node --check dist/entity-progress-card_dev.js",
    "check:release-flags": "node scripts/check-release-flags.js",
    "check:es-target": "es-check es2021 dist/entity-progress-card.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:unused": "knip",
    "format:md": "prettier --write \"**/*.md\" \"!node_modules/**\"",
    "format:js": "prettier --write \"src/**/*.{js,ts}\"",
    "format:js:check": "prettier --check \"src/**/*.{js,ts}\"",
    "format": "npm run format:js && npm run format:md",
    "test": "node scripts/test.js && node --test \"test-dist/**/*.test.mjs\"",
    "test:dom": "node scripts/test.js --dom && node --test \"test-dist/**/*.test.mjs\"",
    "build": "node scripts/build.js",
    "build:test": "node scripts/build.js",
    "build:prod": "node scripts/build.js --prod",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francois-le-ko4la/lovelace-entity-progress-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs"
  ],
  "author": "ko4la",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/francois-le-ko4la/lovelace-entity-progress-card/issues"
  },
  "homepage": "https://github.com/francois-le-ko4la/lovelace-entity-progress-card#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "es-check": "^9.6.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "knip": "^6.33.0",
    "lint-staged": "^17.0.8",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3"
  }
}
